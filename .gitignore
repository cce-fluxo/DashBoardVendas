# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*:Zone.Identifier
*Zone.Identifier

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# saídas dos scripts de descoberta (scripts/inspecionar-*.ts)
descoberta-*.json

# fotos antigas da produção (de um script já removido). Têm números de vendas
# e nomes de pessoas e clientes: se existir uma cópia local, fica fora do git.
/anexos/
pessoas-*.csv
